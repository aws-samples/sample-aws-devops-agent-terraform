# Example Terraform variables file
# Copy this to terraform.tfvars and customize as needed

# AWS region
aws_region = "us-east-1"

# Resource naming (optional - if not provided, random suffix will be used)
# name_postfix = "v2"

# Agent Space configuration
agent_space_name        = "MyCompanyAgentSpace"
agent_space_description = "DevOps Agent Space for monitoring production workloads"

# Part 2 (Optional): Cross-account monitoring
# Set the service account ID to create a source AWS association
# service_account_id = "123456789012"

# Set this to the Agent Space ARN from the initial deployment output.
# Required before deploying the service account resources (IAM role + echo Lambda).
# agent_space_arn = "arn:aws:aidevops:us-east-1:<MONITORING_ACCOUNT_ID>:agentspace/<SPACE_ID>"

# Tags for all resources
tags = {
  Environment = "production"
  Project     = "aws-devops-agent"
  Owner       = "devops-team"
  CostCenter  = "engineering"
}

# Part 3 (Optional): Third-party integrations
# Uncomment and fill in only the services you want to register. Each populated
# block registers a service and associates it with the Agent Space in the same
# apply. These carry secrets — prefer Secrets Manager / SSM over plaintext here,
# and never commit real credentials.
